{
  "rules": {
    ".read": false,
    ".write": false,
    "eventos": {
      ".read": true,
      "$id": {
        ".write": "auth != null && auth.token.email === 'admin@admin.com'",
        ".validate": "newData.child('titulo').isString() && newData.child('titulo').val().length > 0 && newData.child('titulo').val().length <= 120 && newData.child('fecha').isString() && newData.child('fecha').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && (!newData.child('descripcion').exists() || (newData.child('descripcion').isString() && newData.child('descripcion').val().length <= 1000))"
      }
    }
  }
}
